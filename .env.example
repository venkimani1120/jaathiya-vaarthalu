NODE_ENV=development
PORT=3000
SITE_URL=https://your-domain.example
# long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=
# used only by `npm run seed`
ADMIN_EMAIL= Mani
ADMIN_PASSWORD= Mani@123

# Alert to staff for each advertising / subscription enquiry (server/notify.js)
# log = print to the console only (default)
# smsgate = FREE real SMS from your own Android phone (app: SMS Gateway for Android, sms-gate.app)
# telegram = FREE Telegram bot message | msg91, twilio = paid SMS gateways
NOTIFY_PROVIDER=log
# staff mobile numbers for SMS, comma separated (10-digit Indian numbers are fine); empty = phone in config/site.json
NOTIFY_TO= 9490174701
# smsgate: username and password shown in the app (Cloud server). Local mode: SMSGATE_URL=http://<phone-ip>:8080
SMSGATE_USER=
SMSGATE_PASSWORD=
SMSGATE_URL=
# telegram: token from @BotFather; chat ids (comma separated) of staff who pressed Start on the bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# msg91: DLT-approved Flow template with ##kind## ##name## ##phone## ##option## ##place##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# twilio: TWILIO_FROM is your Twilio number in +E.164 form
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp group feed (server/whatsapp.js): posts in these groups become DRAFT articles. Off while WAHA_URL is empty.
# WAHA = self-hosted WhatsApp HTTP API gateway (free Core edition, Docker); see README for setup
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
# group ids, comma separated, e.g. 120363012345678901@g.us
WHATSAPP_GROUPS=
# optional: only these reporters' numbers become drafts (empty = everyone in the group)
WHATSAPP_SENDERS=
# drafts are created under this user (empty = first admin)
WHATSAPP_AUTHOR_EMAIL=
WHATSAPP_POLL_MINUTES=2
# texts shorter than this are chat, not news
WHATSAPP_MIN_CHARS=40
# ignore messages older than this (stops old group history becoming drafts on the first pull)
WHATSAPP_MAX_AGE_HOURS=24
