{
  "name": "jaathiya-vaarthalu-web",
  "version": "0.3.0",
  "private": true,
  "description": "Jaathiya Vaarthalu frontend: renders the public pages (English and Telugu) from the backend API",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch-path=src --watch-path=public src/server.js",
    "build": "node --env-file-if-exists=.env src/build.js",
    "test": "node tests/build.test.js && node tests/server.test.js"
  },
  "engines": {
    "node": ">=22"
  }
}
