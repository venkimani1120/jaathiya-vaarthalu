# Copy to backend/.env for npm run dev (never commit .env)
PORT=4000
# The desk app's database with a read-only user; leave empty to serve content/ only
MONGODB_URI=mongodb+srv://jv-web-reader:<password>@cluster0.xxxxx.mongodb.net/jaathiya?retryWrites=true&w=majority
DESK_APP_URL=https://jaathiya-vaartalu-studio-app.onrender.com
NEWS_DAYS=90
REFRESH_SECONDS=120
# News bulletin voice (optional): CLOUDINARY_URL plus a Gemini key (or Azure, with TTS_PROVIDER=azure). Empty = off.
CLOUDINARY_URL=
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
# TTS_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_TTS_VOICE=te-IN-ShrutiNeural
BULLETIN_DAILY_CHARS=20000
